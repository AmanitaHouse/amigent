#!/bin/sh
# Reject a push that introduces a fork commit whose raw author or committer is not
# this repository's identity. Published origin history and upstream history are
# left alone. This hook does not rewrite commits and does not use the network.

. "$(dirname "$0")/lib.sh"

load_expected

git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null \
    || guard_fail "refs/remotes/origin/main is missing, so published commits cannot be distinguished from new ones. Fail closed."

upstream=$(git rev-parse --verify --quiet 'refs/tags/upstream-v1.4.0^{commit}') \
    || guard_fail "upstream baseline tag upstream-v1.4.0 is missing. Fail closed."

rejected=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    git cat-file -e "$local_sha^{commit}" 2>/dev/null \
        || guard_fail "cannot read commit $local_sha. Fail closed."

    # One --not applies to every revision that follows. Repeating --not toggles it.
    set -- "$local_sha" --not "$upstream"
    for remote_tip in $(git for-each-ref --format='%(objectname)' refs/remotes/origin); do
        set -- "$@" "$remote_tip"
    done
    for ref in $(git for-each-ref --format='%(refname)' 'refs/tags/upstream-*' refs/remotes/upstream); do
        peeled=$(git rev-parse --verify --quiet "$ref^{commit}") \
            || guard_fail "cannot peel $ref. Fail closed."
        set -- "$@" "$peeled"
    done

    commits=$(git rev-list "$@" ) || guard_fail "cannot list commits for $local_ref. Fail closed."
    for c in $commits; do
        if ! check_commit_ident "$c"; then
            rejected=1
        fi
    done
done

[ "$rejected" -eq 0 ] || exit 1
exit 0
